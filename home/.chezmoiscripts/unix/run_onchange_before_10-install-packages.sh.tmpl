#!/bin/bash
set -euo pipefail

BREW=""
for candidate in /home/linuxbrew/.linuxbrew/bin/brew "$HOME/.linuxbrew/bin/brew" /opt/homebrew/bin/brew /usr/local/bin/brew; do
  [ -x "$candidate" ] && BREW="$candidate" && break
done

if [ -z "$BREW" ]; then
  echo "==> Installing Homebrew"
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  for candidate in /home/linuxbrew/.linuxbrew/bin/brew "$HOME/.linuxbrew/bin/brew" /opt/homebrew/bin/brew; do
    [ -x "$candidate" ] && BREW="$candidate" && break
  done
  [ -n "$BREW" ] || { echo "Homebrew installation not found" >&2; exit 1; }
  for rc in "$HOME/.profile" "$HOME/.bashrc"; do
    echo "eval \"\$($BREW shellenv)\"" >> "$rc"
  done
fi
eval "$("$BREW" shellenv)"

# On WSL the Windows PATH is inherited; a /mnt/c tool must not count as installed.
has_native() {
  local found
  found="$(command -v "$1" 2>/dev/null)" && [[ "$found" != /mnt/* ]]
}

missing=()
ensure() {
  if ! has_native "$1"; then
    missing+=("$2")
  fi
}

{{ range .packages -}}
{{ if and (get . "brew") (get . "command") -}}
ensure {{ get . "command" | quote }} {{ get . "brew" | quote }}
{{ end -}}
{{ end }}
# One brew call resolves shared dependencies once instead of per package.
if [ "${#missing[@]}" -gt 0 ]; then
  echo "==> Installing ${missing[*]}"
  HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_INSTALL_CLEANUP=1 brew install "${missing[@]}"
fi

# Node comes from fnm. A machine that already has Node keeps its setup.
if ! has_native node; then
  echo "==> Installing Node LTS with fnm"
  eval "$(fnm env --shell bash)"
  fnm install --lts
  fnm default lts-latest
  for rc in "$HOME/.bashrc" "$HOME/.zshrc"; do
    shell_name="$(basename "$rc" | sed -e 's/^\.//' -e 's/rc$//')"
    if [ -f "$rc" ] && ! grep -q 'fnm env' "$rc"; then
      echo "eval \"\$(fnm env --use-on-cd --shell $shell_name)\"" >> "$rc"
    fi
  done
fi
